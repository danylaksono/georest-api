COMPOSE_PROFILES=db
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=compose.yaml:compose.cache.yaml

GEOREST_DATASET=demo
GEOREST_CONFIG_MODE=auto
# External mode requires a manifest. Relative paths are resolved in this project.
GEOREST_COLLECTIONS_FILE=
PUBLIC_URL=http://localhost
GEOREST_BIND_ADDRESS=127.0.0.1
GEOREST_HTTP_PORT=80
CORS_ORIGINS=*
GEOREST_TITLE=GeoREST API
GEOREST_DESCRIPTION=OGC API Features and vector tiles

PGHOST=postgis
PGPORT=5432
PGDATABASE=gis
PGSSLMODE=prefer
# Demo passwords are for the local loopback fixture.
POSTGRES_PASSWORD=demo-db-password
GEOREST_READER_PASSWORD=demo-reader-password
GEOREST_EDITOR_PASSWORD=demo-editor-password

VARNISH_SIZE=1G
TILE_TTL_DEFAULT=3600
TILE_TTL_VOLATILE=60

# Level 3 requires its own credentials and public HTTPS settings.
DOMAIN=
ACME_EMAIL=
GEOREST_HTTPS_PORT=443
GEOREST_ALLOW_EDITS=false
WRITE_ALLOWLIST=
GEOREST_AUTH_DIR=./config/local/auth
WRITE_BASIC_AUTH_FILE=
API_BASIC_AUTH_FILE=

# Level 4 replaces the Basic auth settings with OIDC.
GEOREST_PRIVATE_READ=false
GEOREST_PRIVATE_TILES=false
KEYCLOAK_REALM_FILE=./config/local/keycloak/realm.json
KEYCLOAK_DB_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Set both on first start, then remove them after provisioning permanent administration.
# KC_BOOTSTRAP_ADMIN_USERNAME=
# KC_BOOTSTRAP_ADMIN_PASSWORD=
